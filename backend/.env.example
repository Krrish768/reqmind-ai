# Copy this file to backend/.env and fill values. Never commit .env
DATABASE_URL=postgresql+psycopg2://reqmind_user:reqmind_pass@localhost:5432/reqmind_db
JWT_SECRET_KEY=change-me-to-a-long-random-string

# true ONLY on Krrish's machine (Ollama installed). Muskaan: false
AI_ENABLED=false

# MinIO (docker compose, default profile)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=reqmind_minio
MINIO_SECRET_KEY=reqmind_minio_pass
MINIO_BUCKET=reqmind-documents
MAX_UPLOAD_MB=10

# AI stack (docker compose --profile ai) + Ollama on host
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=reqmind_chunks
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reqmind_neo4j_pass
MAX_CHUNKS_PER_ANALYSIS=40

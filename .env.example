# Copy to .env in the repo root: cp .env.example .env
# Never commit .env.

# Which file in configs/ to use (without .yaml).
# gpu_laptop = Ollama + all services, cpu_laptop = no Ollama, only Postgres and MinIO
APP_CONFIG=gpu_laptop

# Postgres from docker-compose.yml
DATABASE_URL=postgresql+psycopg2://reqmind_user:reqmind_pass@localhost:5432/reqmind_db

# Any long random string. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Must match docker-compose.yml
NEO4J_PASSWORD=reqmind_neo4j_pass
MINIO_ACCESS_KEY=reqmind_minio
MINIO_SECRET_KEY=reqmind_minio_pass
